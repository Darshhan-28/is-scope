# IS-SCOPE environment — copy to .env and fill in only what you need.
# The prototype runs fully OFFLINE without any key (deterministic fallback is the default path).
# Keys are OPTIONAL and only enable AI terminology hints — the LLM never decides applicability.

# Optional: OpenAI-compatible endpoint for terminology normalization hints only
OPENAI_API_KEY=
# Optional: Gemini key for terminology normalization hints only
GEMINI_API_KEY=
