# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
*.egg-info/

# SQLite (auto-seeded at startup / via seed_data.py — do not commit)
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# Environment / secrets — NEVER commit
.env
.env.local
*.pem
*.key

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Logs / temp
*.log
*.tmp
.opencode/
